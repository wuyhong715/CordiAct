<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug-only WebView host used by the automation probes. -->
        <activity
            android:name=".debug.WebProbeActivity"
            android:exported="true"
            android:label="Web Probe" />

        <!-- Debug-only harness entry point. Never merged into release builds. -->
        <receiver
            android:name=".probe.AutomationProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.cordiact.app.PROBE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
